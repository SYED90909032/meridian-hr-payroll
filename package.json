{
  "name": "meridian",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @meridian/api db:migrate",
    "db:seed": "pnpm --filter @meridian/api db:seed",
    "sdk:generate": "pnpm --filter @meridian/sdk sdk:generate",
    "audit": "pnpm audit --prod"
  }
}
