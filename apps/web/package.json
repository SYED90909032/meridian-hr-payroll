    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@mui/x-charts": "^8.29.3",
    "@simplewebauthn/browser": "^13.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.17",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
