{
  "name": "@meridian/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "icons": "node scripts/build-solar-subset.mjs",
    "predev": "node scripts/build-solar-subset.mjs",
    "dev": "vite",
    "build": "node scripts/build-solar-subset.mjs && tsc -p tsconfig.json --noEmit && vite build",
