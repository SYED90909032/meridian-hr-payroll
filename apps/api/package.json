{
  "name": "@meridian/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1178.0",
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.12",
    "@meridian/engine": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@simplewebauthn/server": "^14.1.0",
    "fastify": "^5.2.0",
    "ioredis": "^6.1.0",
    "nodemailer": "^10.6.1",
    "openid-client": "^6.9.1",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "@types/smtp-server": "^3.5.13",
    "@types/ssh2": "^1.15.6",
    "smtp-server": "^3.21.7",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
