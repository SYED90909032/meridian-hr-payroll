# Copy to .env. Never commit real values.
DATABASE_URL_OWNER=postgres://meridian_owner:CHANGE_ME@localhost:5432/meridian
DATABASE_URL_APP=postgres://meridian_app:CHANGE_ME@localhost:5432/meridian
DATABASE_URL_AUTH=postgres://meridian_auth:CHANGE_ME@localhost:5432/meridian
# 32 random bytes, base64. Master key for the local KMS adapter. Use a managed KMS in production (ADR-011).
MERIDIAN_MASTER_KEY=
# 32 random bytes, base64. Used for blind indexes, pseudonym tokens and action tokens.
MERIDIAN_HMAC_KEY=
# Ed25519 private key, PEM, for audit block signing. Optional in dev.
MERIDIAN_AUDIT_SIGNING_KEY=
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
