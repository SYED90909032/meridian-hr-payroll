# Copy to .env. Never commit real values.
NODE_ENV=development
PORT=8080
DATABASE_URL_OWNER=postgres://meridian_owner:CHANGE_ME@localhost:5432/meridian
DATABASE_URL_APP=postgres://meridian_app:CHANGE_ME@localhost:5432/meridian
DATABASE_URL_AUTH=postgres://meridian_auth:CHANGE_ME@localhost:5432/meridian
DATABASE_URL_WORKER=postgres://meridian_worker:CHANGE_ME@localhost:5432/meridian
# 32 random bytes, base64 (openssl rand -base64 32). Required in production. Master key for the local KMS adapter (ADR-011, open decision D11).
MERIDIAN_MASTER_KEY=
# Production: use AWS KMS and store only this KMS ciphertext, never a plaintext master in env.
KEY_PROVIDER=local
MERIDIAN_WRAPPED_MASTER_KEY=
KMS_KEY_ID=
KMS_REGION=us-east-1
KMS_ENDPOINT=
MERIDIAN_DEPLOYMENT=default
# Secret manager is optional for self-hosting; REQUIRE_SECRET_MANAGER=true makes it mandatory in production.
SECRETS_PROVIDER=env
AWS_SECRETS_MANAGER_SECRET_ID=
REQUIRE_SECRET_MANAGER=false
# 32 random bytes, base64. Ed25519 seed for signing audit blocks. Required in production.
MERIDIAN_SIGNING_KEY=
COOKIE_SECURE=auto
TRUST_PROXY=false
# Optional: directory of the built web app to serve.
WEB_DIST=
# Optional: an OpenAI-compatible endpoint lets the assistant rephrase answers. Without it, answers are built directly from tool results.
OPENAI_API_BASE=
OPENAI_API_KEY=
ASSISTANT_MODEL=

# Bank transport is manual by default; production SFTP requires all pinned credentials.
BANK_TRANSPORT=manual
# BANK_SFTP_HOST=
# BANK_SFTP_PORT=22
# BANK_SFTP_USERNAME=
# BANK_SFTP_PRIVATE_KEY=
# BANK_SFTP_HOST_KEY_SHA256=
# BANK_SFTP_REMOTE_DIR=/inbound
# BANK_SFTP_TIMEOUT_MS=15000
# Comma-separated model names permitted by the assistant gateway; empty disables model calls.
ASSISTANT_ALLOWED_MODELS=
ASSISTANT_REQUEST_MAX_CHARS=4000
ASSISTANT_TIMEOUT_MS=15000
# API keys must expire; creation cannot exceed this lifetime.
API_KEY_MAX_LIFETIME_DAYS=365
API_KEY_EXPIRY_WARNING_DAYS=14
WEBHOOK_DELIVERY_RETENTION_DAYS=90
